{
  "name": "stxt",
  "displayName": "STXT - Semantic Text",
  "description": "Language support for STXT (Semantic Text): highlighting, validation against schemas and templates, completion, hover and formatting.",
  "version": "0.9.0",
  "publisher": "stxt-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/stxt-lang/stxt-vscode"
  },
  "license": "MIT",
  "homepage": "https://stxt.dev",
  "bugs": {
    "url": "https://github.com/stxt-lang/stxt-vscode/issues"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "stxt",
    "semantic text",
    "language",
    "syntax",
    "schema",
    "validation",
    "structured text"
  ],
  "icon": "images/icon.png",
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "stxt",
        "aliases": [
          "STXT (Semantic Text)",
          "STXT"
        ],
        "extensions": [
          ".stxt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "markdownHeading",
        "superType": "keyword",
        "description": "Heading line inside a MARKDOWN block"
      },
      {
        "id": "markdownBold",
        "description": "Bold text inside a MARKDOWN block"
      },
      {
        "id": "markdownItalic",
        "description": "Italic text inside a MARKDOWN block"
      },
      {
        "id": "markdownCode",
        "superType": "string",
        "description": "Inline code or fenced code inside a MARKDOWN block"
      },
      {
        "id": "markdownList",
        "superType": "keyword",
        "description": "List item marker inside a MARKDOWN block"
      },
      {
        "id": "markdownQuote",
        "superType": "comment",
        "description": "Block quote marker inside a MARKDOWN block"
      },
      {
        "id": "markdownLink",
        "description": "Link or image inside a MARKDOWN block"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "stxt",
        "scopes": {
          "markdownHeading": [
            "markup.heading.markdown",
            "entity.name.section.markdown"
          ],
          "markdownBold": [
            "markup.bold.markdown"
          ],
          "markdownItalic": [
            "markup.italic.markdown"
          ],
          "markdownCode": [
            "markup.inline.raw.string.markdown"
          ],
          "markdownList": [
            "markup.list.markdown",
            "punctuation.definition.list.begin.markdown"
          ],
          "markdownQuote": [
            "markup.quote.markdown",
            "punctuation.definition.quote.begin.markdown"
          ],
          "markdownLink": [
            "markup.underline.link.markdown"
          ]
        }
      }
    ],
    "configuration": {
      "title": "STXT",
      "properties": {
        "stxt.developerMode": {
          "type": "boolean",
          "default": false,
          "description": "Show the technical details of the node under the cursor in the hover: form and level, canonical and qualified names, value, schema type and allowed values, text content, and comments. When off, the hover shows only the description the schema or template gives for the node, if there is one."
        }
      }
    },
    "configurationDefaults": {
      "[stxt]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.detectIndentation": false,
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        },
        "editor.wordBasedSuggestions": "off",
        "editor.suggest.showWords": false
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile",
    "test": "mocha"
  },
  "dependencies": {
    "@stxt-lang/core": "^0.9.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "eslint": "^10.8.0",
    "mocha": "^11.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
